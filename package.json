{
  "name": "patikunye",
  "version": "0.1.0",
  "private": true,
  "description": "Veteriner klinikleri için mikroçip ve hayvan takip uygulaması",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dev:server": "tsx watch src/server-dev.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@node-rs/argon2": "^1.9.0",
    "bonjour-service": "^1.3.0",
    "drizzle-orm": "^0.38.0",
    "electron-updater": "^6.3.9",
    "embedded-postgres": "18.4.0-beta.17",
    "fastify": "^5.3.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "selfsigned": "^2.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@tanstack/react-query": "^5.66.0",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.29.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "productName": "PatiKünye",
  "author": "Kadir",
  "build": {
    "appId": "com.patikunye.app",
    "productName": "PatiKünye",
    "executableName": "PatiKunye",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      },
      {
        "from": "migrations",
        "to": "migrations"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@embedded-postgres/**",
      "node_modules/@node-rs/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PatiKunye-Kurulum-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PatiKünye",
      "language": "1055",
      "installerLanguages": [
        "tr_TR"
      ],
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.medical"
    }
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "18.4.0-beta.17"
  }
}
